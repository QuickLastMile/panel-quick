# Copia este archivo a .env.local para desarrollo local. En Vercel, estos
# mismos nombres se configuran como Environment Variables del proyecto.

# JSON completo de la cuenta de servicio de Google (una sola línea).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ID del Google Sheet "Monitoreo Servicios Quick - Tiempo Real".
MONITOREO_SHEET_ID=1gygXBAmYyhxb_oqsswq091wU4LUiEziTj-dlrOsU9gE

# Secreto para firmar las sesiones de login (cualquier cadena larga aleatoria).
AUTH_SECRET=

# Contraseñas de las 3 cuentas fijas (usuario = admin / supervisor / coordinador).
ADMIN_PASSWORD=
SUPERVISOR_PASSWORD=
COORDINADOR_PASSWORD=
